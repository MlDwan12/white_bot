# Скопировать в /opt/white_bot/.env, заполнить, chmod 600.

# Тег образа white-bot, который сейчас запущен (git rev-parse --short HEAD).
APP_TAG=

# Только hex, чтобы не экранировать в DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://white_bot:<тот же пароль>@postgres:5432/white_bot
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=3000
COOKIE_SECURE=true
# Перед приложением ровно один прокси — Caddy.
TRUST_PROXY_HOPS=1
MEDIA_STORAGE_PATH=/app/storage/media
DEFAULT_TIMEZONE=Europe/Moscow

# openssl rand -base64 32. Тот же, что в dev, если переносите токены групп
# из dev-базы; иначе новый. Хранить отдельно от дампов базы.
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 48
JWT_SECRET=

MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://botapi.max.ru

VK_APP_ID=
VK_APP_CLIENT_SECRET=

MINIAPP_ORIGINS=
