NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://white_bot:white_bot@localhost:5433/white_bot
REDIS_URL=redis://localhost:6380

# AES-256-GCM key for encrypting group access tokens at rest, base64-encoded (32 raw bytes).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# VK app credentials — only needed for the personal-uploader OAuth flow that
# uploads photo/document wall attachments (a community token cannot). Leave
# empty to run without VK attachment uploads.
VK_APP_ID=
VK_APP_CLIENT_SECRET=

# MAX bot token (one per bot, covers every chat/channel it's in — unlike VK,
# where each community has its own token). Leave empty to run without the MAX
# integration: long polling stays off and the app logs a warning at startup.
MAX_BOT_TOKEN=

# Host serving the MAX bot API. The SDK's own default (platform-api2.max.ru)
# presents a certificate from the Russian Trusted CA, which isn't in the
# default trust store — every call then fails as an opaque `fetch failed`.
# botapi.max.ru serves the same API behind a publicly trusted certificate.
MAX_API_BASE_URL=https://botapi.max.ru

# Directory for uploaded attachment files. Mounted as a docker volume in
# production so the files outlive container rebuilds.
MEDIA_STORAGE_PATH=./storage/media

# Timezone a recurring post's cron expression is read in. Copied onto each
# template when it is created, so later changes don't move existing schedules.
DEFAULT_TIMEZONE=Europe/Moscow
