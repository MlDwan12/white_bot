generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  vk
  max
}

enum GroupKind {
  community
  chat
  channel
}

enum GroupStatus {
  pending_confirmation
  active
  token_invalid
  bot_removed
  removed
}

enum PostStatus {
  draft
  scheduled
  sending
  sent
  partially_failed
  stopped
}

enum PostDeliveryStatus {
  pending
  sending
  sent
  failed
  skipped_by_stop
  unknown
}

enum MediaKind {
  image
  document
  video
}

enum ContestStatus {
  draft
  open
  drawn
}

enum ContestParticipantSource {
  /// Человек сам нажал кнопку под постом.
  button
  /// Админ добавил руками — запасной путь на случай сбоя кнопки.
  manual
}

enum ContestNotifyStatus {
  pending
  sent
  failed
  /// Уведомить автоматически нечем (нет id платформы) или отправка провалилась
  /// окончательно. Явное состояние вместо тихого отказа: победитель не должен
  /// потеряться из-за недоставленного сообщения.
  manual_required
  notified_manually
}

enum ContestDrawLogKind {
  /// Сам розыгрыш: все места разом, один сид.
  draw
  /// Ручная правка отдельного места после розыгрыша — отдельной записью
  /// со старым и новым значением, а не молчаливой перезаписью.
  override
}

enum AdminRole {
  developer
  admin
}

enum Permission {
  groups_manage
  groups_tags_edit
  groups_tokens_manage
  groups_pendingMax_review
  groups_view
  posts_manage
  contests_manage
  admins_manage
  system_health
  audit_viewAll
}

model Group {
  id                   String      @id @default(uuid())
  platform             Platform
  kind                 GroupKind
  externalId           String
  title                String
  // Nullable: only VK community groups carry their own token. MAX bots
  // authenticate with one bot-wide token (configured once, not per-chat),
  // so a MAX Group row has neither an encrypted token nor a mask.
  accessTokenEncrypted String?
  tokenMask            String?
  tags                 String[]    @default([])
  status               GroupStatus
  createdAt            DateTime    @default(now())

  postDeliveries      PostDelivery[]
  templateTargets     PostTemplateTarget[]
  contestParticipants ContestParticipant[]

  @@unique([platform, externalId])
  @@index([tags], type: Gin)
}

model Post {
  id                     String     @id @default(uuid())
  text                   String
  vkTextOverride         String?
  maxTextOverride        String?
  createdAt              DateTime   @default(now())
  scheduledAt            DateTime?
  recurrenceRule         String?
  templatePaused         Boolean    @default(false)
  /// Только у повторяющегося шаблона: момент следующего срабатывания.
  /// Расписание живёт здесь, а не в repeatable-джобе BullMQ, потому что
  /// источник правды — Postgres: очистка Redis не должна тихо убивать все
  /// повторяющиеся посты.
  nextRunAt              DateTime?
  /// Часовой пояс, в котором трактуется recurrenceRule. Хранится у шаблона,
  /// а не берётся из окружения, чтобы «каждый день в 10:00» означало одно и
  /// то же и после переезда сервера в другой часовой пояс.
  timezone               String?
  autoDeleteAt           DateTime?
  autoDeleteAfterMinutes Int?
  status                 PostStatus @default(draft)
  stopRequested          Boolean    @default(false)
  clonedFromPostId       String?
  recurringTemplateId    String?
  updatedAt              DateTime   @updatedAt

  clonedFromPost    Post?                @relation("PostClone", fields: [clonedFromPostId], references: [id])
  clones            Post[]               @relation("PostClone")
  recurringTemplate Post?                @relation("RecurringOccurrence", fields: [recurringTemplateId], references: [id])
  occurrences       Post[]               @relation("RecurringOccurrence")
  deliveries        PostDelivery[]
  attachments       PostAttachment[]
  contest           Contest?
  templateTargets   PostTemplateTarget[]
  directMessages    DirectMessageDelivery[]

  @@index([clonedFromPostId])
  @@index([recurringTemplateId])
  @@index([status, scheduledAt])
  /// Выборка шаблонов, которым пора сработать.
  // Created as a PARTIAL index (WHERE "recurrenceRule" IS NOT NULL) in
  // 20260918144004_step6c_recurring_schedule — Prisma cannot express that here,
  // and reports no diff against it.
  @@index([templatePaused, nextRunAt])
}

/// Текущий (редактируемый) список целевых групп повторяющегося шаблона —
/// сам шаблон не проходит через доставку, поэтому его цели не выражаются PostDelivery.
model PostTemplateTarget {
  id      String @id @default(uuid())
  postId  String
  groupId String

  post  Post  @relation(fields: [postId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([postId, groupId])
  @@index([groupId])
}

model PostDelivery {
  id                 String             @id @default(uuid())
  postId             String
  groupId            String
  status             PostDeliveryStatus @default(pending)
  externalMessageId  String?
  error              String?
  sentAt             DateTime?
  /// Когда опубликованное сообщение было удалено из группы. Отдельное поле,
  /// а не новый статус: доставка **была** отправлена — это факт истории, а
  /// удаление случилось позже. Статус `deleted` смешивал бы два разных факта
  /// в одном поле и его пришлось бы исключать из «отправить оставшимся».
  deletedAt          DateTime?
  /// Когда это сообщение пора удалить автоматически. Считается в момент
  /// отправки из настроек поста: доставки в разные группы расходятся на
  /// минуты, и «висит час» должно означать час в каждой группе, а не час
  /// от начала кампании. Хранится здесь, а не вычисляется на лету, чтобы
  /// сверщик искал по индексу, а не перебирал все отправленные доставки.
  autoDeleteDueAt    DateTime?
  /// Сколько раз автоудаление уже не удалось. Нужно, чтобы вечно
  /// неудаляемая строка (например, VK без одобренных прав) не занимала
  /// место в окне выборки и не вытесняла тех, кого удалить можно.
  autoDeleteAttempts Int                @default(0)
  attemptsMade       Int                @default(0)
  // Needed to spot a delivery abandoned mid-flight: `sending` is committed
  // before the network call, so a worker that dies leaves the row stuck
  // there. Without a timestamp there's no way to tell "started a second ago"
  // from "orphaned an hour ago", and such a row must go to `unknown` rather
  // than be retried (retrying risks a duplicate post).
  updatedAt          DateTime           @updatedAt

  post  Post  @relation(fields: [postId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([postId, groupId])
  @@index([groupId])
  // The reconciler sweeps for deliveries abandoned in `sending`.
  @@index([status, updatedAt])
  /// Выборка доставок, которым пора автоудаляться.
  @@index([autoDeleteDueAt])
}

enum DirectMessageStatus {
  pending
  sending
  sent
  failed
  /// Недоставимо по конструкции (не MAX, нечисловой id) — не спутать с
  /// настоящим провалом отправки: тот же смысл, что и у
  /// ContestNotifyStatus.manual_required.
  manual_required
  /// Исход неясен (транспорт мог доставить сообщение и потерять только
  /// ответ) — тот же смысл, что и у PostDeliveryStatus.unknown. Отдельно от
  /// failed: без этого статуса ручное «отправить ещё раз тем же текстом
  /// новым постом» рискует задвоить сообщение — unique(postId,
  /// platformUserId) не спасает, раз id поста новый.
  unknown
}

/// Личное сообщение с текстом поста конкретному платформенному пользователю.
/// Отдельно от `PostDelivery` намеренно: та привязана к `Group` (каналу) —
/// личка адресуется человеку, а не каналу, и получателей может быть на
/// порядки больше, чем групп у поста.
model DirectMessageDelivery {
  id                String              @id @default(uuid())
  postId            String
  platformUserId    String
  status            DirectMessageStatus @default(pending)
  externalMessageId String?
  error             String?
  sentAt            DateTime?
  attemptsMade      Int                 @default(0)
  createdAt         DateTime            @default(now())
  // Тот же смысл, что и у PostDelivery.updatedAt: отличить недавно начатую
  // отправку от зависшей — воркер для этой таблицы появится отдельным шагом.
  updatedAt         DateTime            @updatedAt

  post         Post         @relation(fields: [postId], references: [id])
  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])

  // Повторный запуск рассылки по тем же получателям не должен задваивать
  // сообщения — тот же смысл, что unique(postId, groupId) у PostDelivery.
  @@unique([postId, platformUserId])
  @@index([platformUserId])
  @@index([status, updatedAt])
}

/// Загруженный файл. Хранится на диске (путь относительно MEDIA_STORAGE_PATH),
/// в БД — только метаданные: класть байты в Postgres означало бы раздувать
/// дампы, а видео во «Фазе 2» сделало бы это невыносимым.
model MediaAsset {
  id                 String    @id @default(uuid())
  /// Имя, под которым файл загрузили — его видит получатель документа.
  filename           String
  kind               MediaKind
  /// Для изображений определён по содержимому файла, а не по заголовку формы:
  /// Content-Type от клиента подделывается тривиально, а от этого решения
  /// зависит, будем ли мы пережимать файл и каким методом его публиковать.
  mimeType           String
  sizeBytes          Int
  /// sha256 оригинала: позволяет убедиться, что файл на диске не подменён,
  /// и распознать повторную загрузку того же файла.
  checksum           String
  storagePath        String    @unique
  /// Оптимизированный вариант — только для изображений и только если он
  /// реально меньше оригинала. Оригинал остаётся нетронутым всегда.
  optimizedPath      String?   @unique
  optimizedSizeBytes Int?
  createdAt          DateTime  @default(now())

  postAttachments PostAttachment[]
  platformUploads MediaPlatformUpload[]

  @@index([checksum])
}

/// Связь поста с файлами и их порядок. Отдельная таблица, а не JSON-массив в
/// Post: внешний ключ не даёт удалить файл, на который ссылается пост, а
/// позиция задаётся явно, а не смыслом порядка элементов в JSON.
model PostAttachment {
  id           String @id @default(uuid())
  postId       String
  mediaAssetId String
  position     Int

  post       Post       @relation(fields: [postId], references: [id])
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([postId, position])
  @@unique([postId, mediaAssetId])
  @@index([mediaAssetId])
}

/// Кэш ссылок на уже загруженный платформе файл.
///
/// VK требует загружать файл отдельно в каждое сообщество (ссылка вида
/// photo-123_456 принадлежит конкретному владельцу), поэтому для VK ключом
/// служит id группы. У MAX токен вложения выдаётся боту и годится для всех
/// его чатов, поэтому там ключ один на платформу.
///
/// Без кэша повторная попытка после rate-limit или «отправить оставшимся»
/// заливала бы тот же файл заново.
model MediaPlatformUpload {
  id           String   @id @default(uuid())
  mediaAssetId String
  platform     Platform
  /// Group.id для VK; фиксированная строка для MAX. Не nullable намеренно:
  /// в Postgres NULL не равен NULL, и уникальный индекс с NULL не помешал бы
  /// дубликатам для MAX.
  scope        String
  externalRef  String
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([mediaAssetId, platform, scope])
}

model Contest {
  id                   String        @id @default(uuid())
  /// Анонс-пост с кнопкой участия. Пост может уходить в несколько групп —
  /// пул участников при этом общий, а группа входа фиксируется у участника.
  /// Nullable: конкурс без анонса живёт на ручном списке участников.
  postId               String?       @unique
  title                String
  status               ContestStatus @default(draft)
  createdAt            DateTime      @default(now())
  /// Подписи кнопки до и после розыгрыша. Кнопка одна и та же: по завершении
  /// её подпись подменяется через editMessage (проверено живьём на MAX).
  joinButtonLabel      String        @default("Участвовать")
  resultsButtonLabel   String        @default("Узнать результаты")
  /// Слать ли победителю личное сообщение — по требованию отключаемо.
  notifyWinners        Boolean       @default(true)
  /// Дописывать ли список победителей в текст анонса при розыгрыше.
  /// Временная мера: в MAX нечем показать что-то одному человеку, а лс от
  /// бота доходит не всем — тот, кто сам не писал боту, его не получит.
  /// Пост — единственный канал, который видят все подписчики. Уйдёт, когда
  /// появится мини-апп со своим экраном результатов.
  publishResultsInPost Boolean       @default(true)

  post         Post?                @relation(fields: [postId], references: [id])
  participants ContestParticipant[]
  prizes       ContestPrize[]
  drawLogs     ContestDrawLog[]
}

/// Профиль человека с платформы: заводится при первом же участии и живёт
/// дальше самостоятельно. Участник конкурса — это факт «он записался вот
/// сюда», а профиль — «вот что мы про него знаем»; смешивать их в одной
/// строке значило бы дублировать имя и username в каждом конкурсе и терять
/// историю, как только конкурс удалят.
model PlatformUser {
  id             String   @id @default(uuid())
  platform       Platform
  externalUserId String
  displayName    String
  firstName      String?
  lastName       String?
  username       String?
  isBot          Boolean  @default(false)
  /// Сырой профиль, как его отдала платформа. Поля у платформ разные и со
  /// временем прибавляются — типизированные колонки покрывают то, что нужно
  /// в выдаче, а снимок сохраняет остальное, не требуя миграции на каждый
  /// новый атрибут.
  profile        Json?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  /// Когда человек нажал «Продолжить» на экране согласия на обработку
  /// персональных данных (152-ФЗ, требование MAX). `null` — согласия ещё
  /// нет, и любое действие бота в личном диалоге сначала показывает этот
  /// экран вместо того, ради чего человек пришёл.
  consentedAt    DateTime?

  contestEntries ContestParticipant[]
  directMessages DirectMessageDelivery[]

  @@unique([platform, externalUserId])
}

model ContestParticipant {
  id             String                   @id @default(uuid())
  contestId      String
  displayName    String
  platform       Platform
  /// Id пользователя на платформе. Nullable: ручная строка без ссылки даёт
  /// участника без id — его нельзя уведомить автоматически.
  externalUserId String?
  /// Из какой группы человек вошёл. Пул общий на весь конкурс, поэтому это
  /// справочное поле, а не часть ключа дедупликации. Nullable у ручных.
  groupId        String?
  joinedAt       DateTime                 @default(now())
  source         ContestParticipantSource @default(button)
  /// Профиль человека, если он известен. Null у ручной строки без ссылки:
  /// про такого участника нет ничего, кроме имени, написанного админом.
  platformUserId String?
  /// Нормализованный ключ дедупликации: `<платформа>:<id>`, а без id —
  /// `name:<имя в нижнем регистре>`. Группа в ключ не входит: нажатие в двух
  /// группах одного конкурса — один участник, иначе у него удвоился бы шанс.
  dedupKey       String

  contest      Contest        @relation(fields: [contestId], references: [id])
  group        Group?         @relation(fields: [groupId], references: [id])
  platformUser PlatformUser?  @relation(fields: [platformUserId], references: [id])
  prizes       ContestPrize[]

  @@unique([contestId, dedupKey])
  @@index([contestId])
  @@index([groupId])
  @@index([platformUserId])
}

model ContestPrize {
  id                  String              @id @default(uuid())
  contestId           String
  place               Int
  label               String
  winnerParticipantId String?
  isForced            Boolean             @default(false)
  notifyStatus        ContestNotifyStatus @default(pending)
  notifyError         String?
  notifyAttemptedAt   DateTime?

  contest           Contest             @relation(fields: [contestId], references: [id])
  winnerParticipant ContestParticipant? @relation(fields: [winnerParticipantId], references: [id])

  @@unique([contestId, place])
  @@unique([winnerParticipantId])
}

model ContestDrawLog {
  id             String             @id @default(uuid())
  contestId      String
  drawnAt        DateTime           @default(now())
  resultSnapshot Json
  note           String?
  /// Кто провёл розыгрыш. Nullable до Шага 9: guard'ов ещё нет, запрос
  /// неаутентифицирован, и писать сюда выдуманного админа хуже, чем null.
  actorId        String?
  kind           ContestDrawLogKind @default(draw)
  /// Сид розыгрыша (hex). Тасовка из него детерминирована, поэтому розыгрыш
  /// можно пересчитать и доказать, что он не подкручен. Null у записей-правок.
  seed           String?

  contest Contest    @relation(fields: [contestId], references: [id])
  actor   AdminUser? @relation(fields: [actorId], references: [id])

  @@index([contestId])
  @@index([actorId])
}

model AdminUser {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  role             AdminRole
  maxUserId        String?      @unique
  extraPermissions Permission[] @default([])
  createdAt        DateTime     @default(now())

  sessions AdminSession[]
  drawLogs ContestDrawLog[]
}

model AdminSession {
  id               String    @id @default(uuid())
  adminUserId      String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revoked          Boolean   @default(false)
  /// Когда токен погашен. Нужно, чтобы отличить гонку вкладок от кражи:
  /// повторное обновление через секунду после законного — это повтор
  /// запроса, а через час — чужие руки.
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
}

/// Personal VK access token used only for wall photo/document uploads —
/// VK community tokens cannot call photos.getWallUploadServer/docs.getWallUploadServer
/// at all (confirmed empirically: error 27 "unavailable with group auth").
/// A single admin's personal token covers every connected community they
/// administer (group_id is passed per-call), so this is a singleton row
/// (fixed id "singleton"), not per-Group. Classic VK OAuth issues no
/// refresh_token, so renewal is a manual re-authorization link, not automatic.
model VkUploaderToken {
  id                   String   @id @default("singleton")
  accessTokenEncrypted String
  vkUserId             String
  expiresAt            DateTime
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}
