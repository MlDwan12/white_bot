generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  vk
  max
}

enum GroupKind {
  community
  chat
  channel
}

enum GroupStatus {
  pending_confirmation
  active
  token_invalid
  bot_removed
  removed
}

enum PostStatus {
  draft
  scheduled
  sending
  sent
  partially_failed
  stopped
}

enum PostDeliveryStatus {
  pending
  sending
  sent
  failed
  skipped_by_stop
  unknown
}

enum MediaKind {
  image
  document
}

enum ContestStatus {
  draft
  open
  drawn
}

enum AdminRole {
  developer
  admin
}

enum Permission {
  groups_manage
  groups_tags_edit
  groups_tokens_manage
  groups_pendingMax_review
  groups_view
  posts_manage
  contests_manage
  admins_manage
  system_health
  audit_viewAll
}

model Group {
  id                   String      @id @default(uuid())
  platform             Platform
  kind                 GroupKind
  externalId           String
  title                String
  // Nullable: only VK community groups carry their own token. MAX bots
  // authenticate with one bot-wide token (configured once, not per-chat),
  // so a MAX Group row has neither an encrypted token nor a mask.
  accessTokenEncrypted String?
  tokenMask            String?
  tags                 String[]    @default([])
  status               GroupStatus
  createdAt            DateTime    @default(now())

  postDeliveries  PostDelivery[]
  templateTargets PostTemplateTarget[]

  @@unique([platform, externalId])
  @@index([tags], type: Gin)
}

model Post {
  id                     String     @id @default(uuid())
  text                   String
  vkTextOverride         String?
  maxTextOverride        String?
  createdAt              DateTime   @default(now())
  scheduledAt            DateTime?
  recurrenceRule         String?
  templatePaused         Boolean    @default(false)
  /// Только у повторяющегося шаблона: момент следующего срабатывания.
  /// Расписание живёт здесь, а не в repeatable-джобе BullMQ, потому что
  /// источник правды — Postgres: очистка Redis не должна тихо убивать все
  /// повторяющиеся посты.
  nextRunAt              DateTime?
  /// Часовой пояс, в котором трактуется recurrenceRule. Хранится у шаблона,
  /// а не берётся из окружения, чтобы «каждый день в 10:00» означало одно и
  /// то же и после переезда сервера в другой часовой пояс.
  timezone               String?
  autoDeleteAt           DateTime?
  autoDeleteAfterMinutes Int?
  status                 PostStatus @default(draft)
  stopRequested          Boolean    @default(false)
  clonedFromPostId       String?
  recurringTemplateId    String?
  updatedAt              DateTime   @updatedAt

  clonedFromPost    Post?                @relation("PostClone", fields: [clonedFromPostId], references: [id])
  clones            Post[]               @relation("PostClone")
  recurringTemplate Post?                @relation("RecurringOccurrence", fields: [recurringTemplateId], references: [id])
  occurrences       Post[]               @relation("RecurringOccurrence")
  deliveries        PostDelivery[]
  attachments       PostAttachment[]
  contest           Contest?
  templateTargets   PostTemplateTarget[]

  @@index([clonedFromPostId])
  @@index([recurringTemplateId])
  @@index([status, scheduledAt])
  /// Выборка шаблонов, которым пора сработать.
  // Created as a PARTIAL index (WHERE "recurrenceRule" IS NOT NULL) in
  // 20260918144004_step6c_recurring_schedule — Prisma cannot express that here,
  // and reports no diff against it.
  @@index([templatePaused, nextRunAt])
}

/// Текущий (редактируемый) список целевых групп повторяющегося шаблона —
/// сам шаблон не проходит через доставку, поэтому его цели не выражаются PostDelivery.
model PostTemplateTarget {
  id      String @id @default(uuid())
  postId  String
  groupId String

  post  Post  @relation(fields: [postId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([postId, groupId])
  @@index([groupId])
}

model PostDelivery {
  id                String             @id @default(uuid())
  postId            String
  groupId           String
  status            PostDeliveryStatus @default(pending)
  externalMessageId String?
  error             String?
  sentAt            DateTime?
  attemptsMade      Int                @default(0)
  // Needed to spot a delivery abandoned mid-flight: `sending` is committed
  // before the network call, so a worker that dies leaves the row stuck
  // there. Without a timestamp there's no way to tell "started a second ago"
  // from "orphaned an hour ago", and such a row must go to `unknown` rather
  // than be retried (retrying risks a duplicate post).
  updatedAt         DateTime           @updatedAt

  post  Post  @relation(fields: [postId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([postId, groupId])
  @@index([groupId])
  // The reconciler sweeps for deliveries abandoned in `sending`.
  @@index([status, updatedAt])
}

/// Загруженный файл. Хранится на диске (путь относительно MEDIA_STORAGE_PATH),
/// в БД — только метаданные: класть байты в Postgres означало бы раздувать
/// дампы, а видео во «Фазе 2» сделало бы это невыносимым.
model MediaAsset {
  id       String    @id @default(uuid())
  /// Имя, под которым файл загрузили — его видит получатель документа.
  filename String
  kind     MediaKind
  /// Для изображений определён по содержимому файла, а не по заголовку формы:
  /// Content-Type от клиента подделывается тривиально, а от этого решения
  /// зависит, будем ли мы пережимать файл и каким методом его публиковать.
  mimeType String
  sizeBytes Int
  /// sha256 оригинала: позволяет убедиться, что файл на диске не подменён,
  /// и распознать повторную загрузку того же файла.
  checksum String
  storagePath String @unique
  /// Оптимизированный вариант — только для изображений и только если он
  /// реально меньше оригинала. Оригинал остаётся нетронутым всегда.
  optimizedPath String? @unique
  optimizedSizeBytes Int?
  createdAt DateTime @default(now())

  postAttachments PostAttachment[]
  platformUploads MediaPlatformUpload[]

  @@index([checksum])
}

/// Связь поста с файлами и их порядок. Отдельная таблица, а не JSON-массив в
/// Post: внешний ключ не даёт удалить файл, на который ссылается пост, а
/// позиция задаётся явно, а не смыслом порядка элементов в JSON.
model PostAttachment {
  id           String @id @default(uuid())
  postId       String
  mediaAssetId String
  position     Int

  post       Post       @relation(fields: [postId], references: [id])
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([postId, position])
  @@unique([postId, mediaAssetId])
  @@index([mediaAssetId])
}

/// Кэш ссылок на уже загруженный платформе файл.
///
/// VK требует загружать файл отдельно в каждое сообщество (ссылка вида
/// photo-123_456 принадлежит конкретному владельцу), поэтому для VK ключом
/// служит id группы. У MAX токен вложения выдаётся боту и годится для всех
/// его чатов, поэтому там ключ один на платформу.
///
/// Без кэша повторная попытка после rate-limit или «отправить оставшимся»
/// заливала бы тот же файл заново.
model MediaPlatformUpload {
  id           String   @id @default(uuid())
  mediaAssetId String
  platform     Platform
  /// Group.id для VK; фиксированная строка для MAX. Не nullable намеренно:
  /// в Postgres NULL не равен NULL, и уникальный индекс с NULL не помешал бы
  /// дубликатам для MAX.
  scope        String
  externalRef  String
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([mediaAssetId, platform, scope])
}

model Contest {
  id        String        @id @default(uuid())
  postId    String?       @unique
  title     String
  status    ContestStatus @default(draft)
  createdAt DateTime      @default(now())

  post         Post?                @relation(fields: [postId], references: [id])
  participants ContestParticipant[]
  prizes       ContestPrize[]
  drawLogs     ContestDrawLog[]
}

model ContestParticipant {
  id          String  @id @default(uuid())
  contestId   String
  displayName String
  vkId        String?
  maxId       String?

  contest Contest        @relation(fields: [contestId], references: [id])
  prizes  ContestPrize[]

  @@index([contestId])
}

model ContestPrize {
  id                  String  @id @default(uuid())
  contestId           String
  place               Int
  label               String
  winnerParticipantId String?
  isForced            Boolean @default(false)

  contest           Contest             @relation(fields: [contestId], references: [id])
  winnerParticipant ContestParticipant? @relation(fields: [winnerParticipantId], references: [id])

  @@unique([contestId, place])
  @@unique([winnerParticipantId])
}

model ContestDrawLog {
  id             String   @id @default(uuid())
  contestId      String
  drawnAt        DateTime @default(now())
  resultSnapshot Json
  note           String?
  actorId        String

  contest Contest   @relation(fields: [contestId], references: [id])
  actor   AdminUser @relation(fields: [actorId], references: [id])

  @@index([contestId])
  @@index([actorId])
}

model AdminUser {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  role             AdminRole
  maxUserId        String?      @unique
  extraPermissions Permission[] @default([])
  createdAt        DateTime     @default(now())

  sessions AdminSession[]
  drawLogs ContestDrawLog[]
}

model AdminSession {
  id               String   @id @default(uuid())
  adminUserId      String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
}

/// Personal VK access token used only for wall photo/document uploads —
/// VK community tokens cannot call photos.getWallUploadServer/docs.getWallUploadServer
/// at all (confirmed empirically: error 27 "unavailable with group auth").
/// A single admin's personal token covers every connected community they
/// administer (group_id is passed per-call), so this is a singleton row
/// (fixed id "singleton"), not per-Group. Classic VK OAuth issues no
/// refresh_token, so renewal is a manual re-authorization link, not automatic.
model VkUploaderToken {
  id                   String   @id @default("singleton")
  accessTokenEncrypted String
  vkUserId             String
  expiresAt            DateTime
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}
