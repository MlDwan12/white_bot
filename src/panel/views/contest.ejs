<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="page-title m-0"><%= contest.title %></h1>
    <div class="text-secondary small mt-1">
      <span class="tag tag-<%= contestColor(contest.status) %>"><%= contestLabel(contest.status) %></span>
      · создан <%= formatDate(contest.createdAt) %>
      <% if (contest.startsAt) { %>
        · начало <%= formatDate(contest.startsAt) %><% if (contest.status === 'draft') { %> (откроется автоматически)<% } %>
      <% } %>
      <% if (contest.endsAt) { %>
        · завершение <%= formatDate(contest.endsAt) %><% if (contest.status === 'open') { %> (разыграется автоматически)<% } %>
      <% } %>
    </div>
    <% if (contest.requiredGroups.length > 0) { %>
      <div class="small mt-1">
        Условие: подписка на
        <% contest.requiredGroups.forEach(function (r, i) { %><%= i > 0 ? ', ' : '' %>«<%= r.group.title %>»<% if (r.group.status !== 'active') { %> <span class="text-secondary">(не проверяется — группа не активна)</span><% } %><% }); %>
      </div>
    <% } %>
  </div>
  <div class="d-flex gap-2">
    <% if (contest.status === 'draft') { %>
      <form method="post" action="/panel/contests/<%= contest.id %>/open" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-primary" type="submit">Опубликовать</button>
      </form>
    <% } %>
    <% if (contest.status !== 'drawn') { %>
      <form method="post" action="/panel/contests/<%= contest.id %>/draw" class="m-0"
            onsubmit="return confirm('Розыгрыш проводится один раз: приём закроется, места разойдутся, победителям уйдут уведомления. Продолжить?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-danger" type="submit">Разыграть</button>
      </form>
      <form method="post" action="/panel/contests/<%= contest.id %>/delete" class="m-0"
            onsubmit="return confirm('Удалить конкурс? Сообщения уберутся из всех каналов, участники и места сотрутся. Это необратимо.')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-outline-danger" type="submit">Удалить</button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <% if (contest.post) { %>
      <%
         /* Текст, картинка и каналы конкурса. Хранятся в служебном посте
            публикации, но правятся только здесь: вид сообщения зависит от
            статуса конкурса (до розыгрыша — «Участвовать (N)», после —
            итоги), и правка мимо конкурса его бы ломала. Каналы меняются
            только до публикации. */
         var publishedPost = contest.post.status !== 'draft';
      %>
      <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Публикация</h3></div>
        <form method="post" action="/panel/contests/<%= contest.id %>/publication">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label" for="publication-text">Текст конкурса</label>
              <textarea class="form-control" id="publication-text" name="text" rows="5"
                        required><%= contest.post.text %></textarea>
              <% if (publishedPost) { %>
                <small class="form-hint">
                  Уже опубликован — сохранение обновит сообщения во всех каналах.
                  <% if (contest.status === 'drawn' && contest.publishResultsInPost) { %>Список победителей допишется сам.<% } %>
                </small>
              <% } %>
            </div>
            <% if (publicationMedia.length > 0) { %>
              <div class="mb-3">
                <label class="form-label">Картинка</label>
                <% publicationMedia.forEach(function (m) { %>
                  <label class="form-check d-flex align-items-center">
                    <input class="form-check-input" type="checkbox" name="attachmentIds"
                           value="<%= m.id %>"
                           <%= publicationAttachedIds.includes(m.id) ? 'checked' : '' %> />
                    <span class="form-check-label d-flex align-items-center">
                      <%- include('media-thumb', { m: m }) %>
                      <%= m.filename %> <span class="text-secondary small ms-1"><%= mediaKindLabel(m.kind) %></span>
                    </span>
                  </label>
                <% }); %>
              </div>
            <% } %>
            <div class="mb-1">
              <label class="form-label">Каналы</label>
              <% if (publishedPost) { %>
                <% contest.post.deliveries.forEach(function (d) { %>
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <%= d.group.title %>
                    <span class="tag tag-<%= deliveryColor(d) %>"><%= deliveryLabel(d) %></span>
                    <% if (d.error) { %><span class="text-danger small"><%= d.error %></span><% } %>
                  </div>
                <% }); %>
                <% var resumable = contest.post.deliveries.some(function (d) { return d.status === 'failed' || d.status === 'skipped_by_stop'; }); %>
                <% if (resumable) { %>
                  <%
                     /* Отдельная форма через `form=`: вложенные формы HTML не
                        допускает, а эта кнопка стоит внутри формы правки. */
                  %>
                  <button class="btn btn-sm mt-1" type="submit" form="publication-resume">Отправить оставшимся</button>
                <% } %>
              <% } else { %>
                <% var chosen = contest.post.deliveries.map(function (d) { return d.groupId; }); %>
                <% maxGroups.forEach(function (g) { %>
                  <label class="form-check">
                    <input class="form-check-input" type="checkbox" name="groupIds"
                           value="<%= g.id %>" <%= chosen.includes(g.id) ? 'checked' : '' %> />
                    <span class="form-check-label"><%= g.title %></span>
                  </label>
                <% }); %>
                <%
                   /* Каналы черновика вне списка выше (только активные MAX).
                      VK у конкурсов до правила «только MAX» — активна, её
                      можно оставить галочкой. Неактивную черновик хранить не
                      может (рассылка в неё запрещена), и при сохранении она
                      уйдёт — об этом говорим прямо, а не молча. */
                %>
                <% contest.post.deliveries.filter(function (d) { return d.group.status === 'active' && d.group.platform !== 'max'; }).forEach(function (d) { %>
                  <label class="form-check">
                    <input class="form-check-input" type="checkbox" name="groupIds"
                           value="<%= d.groupId %>" checked />
                    <span class="form-check-label"><%= d.group.title %>
                      <span class="text-secondary">(VK — кнопки участия там не будет)</span></span>
                  </label>
                <% }); %>
                <% contest.post.deliveries.filter(function (d) { return d.group.status !== 'active'; }).forEach(function (d) { %>
                  <div class="text-warning small mb-1">
                    «<%= d.group.title %>» — бот не активен; при сохранении канал уберётся из публикации.
                  </div>
                <% }); %>
                <small class="form-hint">Хотя бы один. После публикации каналы не меняются.</small>
              <% } %>
            </div>
          </div>
          <div class="card-footer">
            <button class="btn btn-primary" type="submit">Сохранить</button>
          </div>
        </form>
        <form id="publication-resume" method="post" class="d-none"
              action="/panel/contests/<%= contest.id %>/publication/resume">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        </form>
        <form method="post" action="/panel/contests/<%= contest.id %>/publication/media"
              enctype="multipart/form-data" class="card-footer d-flex gap-2 align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input class="form-control" type="file" name="file" required />
          <button class="btn" type="submit">Загрузить</button>
        </form>
        <div class="card-footer text-secondary small pt-0">
          Загруженный файл отметится в списке выше и прикрепится по «Сохранить».
          Набранный, но не сохранённый текст при загрузке пропадёт — сохраните его сначала.
        </div>
      </div>
    <% } %>
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title">Призовые места</h3>
      </div>
      <div class="card-body">
        <% if (contest.status === 'drawn') { %>
          <p class="text-secondary m-0">
            После розыгрыша места не меняются — менять можно только того, кто
            их занял.
          </p>
        <% } else if (!prizesEditable) { %>
          <p class="text-secondary m-0">
            Места заведены через API — с пропусками в нумерации или переносом
            строки в подписи. Поле с подписями воспроизвести их не может: оно
            нумерует места подряд и делит текст по строкам, поэтому правка
            отсюда закрыта.
          </p>
        <% } else { %>
          <% if (forcedPlaces.length > 0) { %>
            <div class="alert alert-warning" role="alert">
              Сохранение списка снимет закрепления (места:
              <%= forcedPlaces.join(', ') %>) — закреплять придётся заново.
            </div>
          <% } %>
          <form method="post" action="/panel/contests/<%= contest.id %>/prizes" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <textarea class="form-control" name="prizes" rows="4"
                      placeholder="Сертификат на 5000&#10;Кружка&#10;Стикерпак"><%= prizesText %></textarea>
            <small class="form-hint">
              По строке на место, сверху вниз: первая строка — первое место.
              Сохранение заменяет весь список: места создаются заново, и
              выбранные вручную победители с них снимаются.
            </small>
            <button class="btn btn-primary mt-2" type="submit">Сохранить места</button>
          </form>
        <% } %>
      </div>
      <% if (contest.prizes.length > 0) { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th class="w-1">Место</th>
                <th>Приз</th>
                <th>Победитель</th>
              </tr>
            </thead>
            <tbody>
              <% contest.prizes.forEach(function (prize) { %>
                <tr>
                  <td><%= prize.place %></td>
                  <td><%= prize.label %></td>
                  <td>
                    <% if (prize.winnerParticipant) { %>
                      <%= prize.winnerParticipant.displayName %>
                      <% if (prize.isForced) { %>
                        <span class="tag tag-orange ms-1">выбран вручную</span>
                      <% } %>
                      <div class="small">
                        <span class="tone-<%= notifyColor(prize.notifyStatus) %>">
                          <%= notifyLabel(prize.notifyStatus) %>
                        </span>
                        <% if (prize.notifyError) { %>
                          <span class="text-secondary">· <%= prize.notifyError %></span>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-secondary">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <%
       /* Правка победителей. До розыгрыша это «подкрутка» — она спрятана в
          свёрнутый блок намеренно: действие законное (место можно обещать
          заранее), но случайно кликать по нему незачем. После розыгрыша тот
          же по смыслу экран открыт, потому что замена отпавшего победителя —
          рядовая работа. Оба пути пишут в журнал розыгрыша. */
    %>
    <% if (contest.prizes.length > 0 && (contest.participants.length > 0 || contest.status !== 'drawn')) { %>
      <% if (contest.status === 'drawn') { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Замена победителя</h3></div>
          <div class="card-body">
            <% contest.prizes.forEach(function (prize) { %>
              <form method="post"
                    action="/panel/contests/<%= contest.id %>/prizes/<%= prize.id %>/override-winner"
                    class="mb-3 d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div>
                  <label class="form-label">Место <%= prize.place %> — <%= prize.label %></label>
                  <select class="form-select" name="participantId" required>
                    <option value="">— выберите участника —</option>
                    <% contest.participants.forEach(function (p) { %>
                      <option value="<%= p.id %>"
                        <%= prize.winnerParticipantId === p.id ? 'selected' : '' %>>
                        <%= p.displayName %>
                      </option>
                    <% }); %>
                  </select>
                </div>
                <input class="form-control" style="width: 16rem" name="note"
                       placeholder="причина замены" />
                <button class="btn" type="submit">Заменить</button>
              </form>
            <% }); %>
            <p class="text-secondary small m-0">
              Замена попадёт в журнал со старым и новым победителем, а итоги
              объявятся заново.
            </p>
          </div>
        </div>
      <% } else { %>
        <details class="card mb-3">
          <summary class="card-header" style="cursor: pointer">
            <h3 class="card-title m-0">Закрепить место за участником</h3>
          </summary>
          <div class="card-body">
            <p class="text-secondary">
              Место достанется указанному человеку, а розыгрыш разыграет
              только оставшиеся. Отметка «выбран вручную» останется видна на
              странице и уйдёт в журнал розыгрыша.
            </p>
            <% if (contest.participants.length === 0) { %>
              <%
                 /* Закрепить можно только участника. Раньше без участников
                    блока не было вовсе, и было непонятно, куда он делся. */
              %>
              <p class="m-0">
                Закрепить можно только участника, а их пока нет. Нужного
                человека можно добавить заранее в блоке «Участники» справа —
                строкой с именем и ником MAX, например <code>Иван @ivan_nick</code>,
                — и он появится здесь. Уведомление о победе такой ручной
                участник не получит: у него нет MAX id.
              </p>
            <% } %>
            <% contest.participants.length > 0 && contest.prizes.forEach(function (prize) { %>
              <form method="post"
                    action="/panel/contests/<%= contest.id %>/prizes/<%= prize.id %>/force-winner"
                    class="mb-2 d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div>
                  <label class="form-label">Место <%= prize.place %> — <%= prize.label %></label>
                  <select class="form-select" name="participantId" required>
                    <option value="">— выберите участника —</option>
                    <% contest.participants.forEach(function (p) { %>
                      <option value="<%= p.id %>"
                        <%= prize.isForced && prize.winnerParticipantId === p.id ? 'selected' : '' %>>
                        <%= p.displayName %>
                      </option>
                    <% }); %>
                  </select>
                </div>
                <button class="btn" type="submit">Закрепить</button>
              </form>
            <% }); %>
          </div>
        </details>
      <% } %>
    <% } %>

    <div class="card">
      <div class="card-header"><h3 class="card-title">Журнал розыгрыша</h3></div>
      <% if (contest.drawLogs.length === 0) { %>
        <div class="card-body text-secondary">Розыгрыша ещё не было.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <tbody>
              <% contest.drawLogs.forEach(function (log) { %>
                <tr>
                  <td class="w-1 text-nowrap"><%= formatDate(log.drawnAt) %></td>
                  <td>
                    <%= log.kind === 'draw' ? 'розыгрыш' : 'правка места' %>
                    <% if (log.note) { %>
                      <div class="text-secondary small"><%= log.note %></div>
                    <% } %>
                    <% if (log.seed) { %>
                      <%
                         /* Сид показывается целиком: по нему и списку
                            участников розыгрыш пересчитывается, и это
                            единственное доказательство, что он не подкручен. */
                      %>
                      <div class="text-secondary small">сид <%= log.seed %></div>
                    <% } %>
                    <%
                       var disqualified = (log.resultSnapshot && log.resultSnapshot.disqualifiedParticipantIds) || [];
                    %>
                    <% if (disqualified.length > 0) { %>
                      <div class="text-secondary small">
                        выбыли, отписавшись от каналов-условий:
                        <%= disqualified.map(function (id) {
                              var p = contest.participants.find(function (x) { return x.id === id; });
                              return p ? p.displayName : id;
                            }).join(', ') %>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title">Участники</h3>
        <span class="ms-auto text-secondary"><%= contest.participants.length %></span>
      </div>
      <% if (contest.status !== 'drawn') { %>
        <div class="card-body">
          <form method="post" action="/panel/contests/<%= contest.id %>/participants" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <textarea class="form-control" name="text" rows="4"
                      placeholder="Иван Иванов, vk.com/id123&#10;Пётр Петров @max_nick"></textarea>
            <small class="form-hint">
              По участнику в строке: имя и ссылка или ник. Повторы не
              добавятся — номера таких строк покажутся после сохранения.
            </small>
            <div class="mt-2 d-flex gap-2 align-items-center">
              <label class="form-label m-0" for="platform">Площадка</label>
              <select class="form-select w-auto" id="platform" name="platform">
                <option value="max">MAX</option>
                <option value="vk">VK</option>
              </select>
              <button class="btn btn-primary ms-auto" type="submit">Добавить</button>
            </div>
            <small class="form-hint">
              Нужна только строкам без ссылки и ника: по ссылке площадка
              видна и так.
            </small>
          </form>
        </div>
      <% } %>
      <% if (contest.participants.length > 0) { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <tbody>
              <% contest.participants.forEach(function (p) { %>
                <tr>
                  <td>
                    <%= p.displayName %>
                    <% if (p.source === 'manual') { %>
                      <span class="tag tag-secondary ms-1">вручную</span>
                    <% } %>
                    <div class="text-secondary small">
                      <%= platformLabel(p.platform) %>
                      <% if (p.externalUserId) { %>
                        · <%= p.externalUserId %>
                      <% } else { %>
                        · без id — уведомить автоматически нечем
                      <% } %>
                      <% if (p.group) { %>
                        · из «<%= p.group.title %>»
                      <% } %>
                    </div>
                  </td>
                  <td class="w-1 text-nowrap text-secondary small"><%= formatDate(p.joinedAt) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card-body text-secondary">Пока никто не участвует.</div>
      <% } %>
    </div>

    <%
       /* До розыгрыша включительно — открытый приём это не «уже
          опубликовано и нельзя трогать», а «идёт сейчас», и дату
          завершения, например, иногда нужно подвинуть, пока конкурс живой.
          После `drawn` условия менять поздно: розыгрыш уже состоялся по
          старым. Текст и картинка конкурса — в блоке «Публикация» выше. */
    %>
    <% if (contest.status !== 'drawn') { %>
      <div class="card">
        <div class="card-header"><h3 class="card-title">Править конкурс</h3></div>
        <form method="post" action="/panel/contests/<%= contest.id %>/edit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label" for="contest-edit-title">Заголовок</label>
              <input class="form-control" id="contest-edit-title" name="title" required
                     value="<%= contestEditDraft.title %>" />
              <small class="form-hint">Видно только в панели.</small>
            </div>
            <div class="mb-3">
              <label class="form-label" for="contest-edit-join">Текст кнопки участия</label>
              <input class="form-control" id="contest-edit-join" name="joinButtonLabel"
                     value="<%= contestEditDraft.joinButtonLabel %>" />
            </div>
            <div class="mb-3">
              <label class="form-label" for="contest-edit-results">Текст кнопки итогов</label>
              <input class="form-control" id="contest-edit-results" name="resultsButtonLabel"
                     value="<%= contestEditDraft.resultsButtonLabel %>" />
            </div>
            <div class="row g-3 mb-3">
              <div class="col-sm-6">
                <label class="form-label" for="contest-edit-startsAt">Начало</label>
                <%
                   /* `readonly`, не убрано из формы: поле продолжает
                      уходить с сабмитом неизменным, так что заголовок
                      можно поправить, не обнулив дату начала заодно (её
                      тогда переписало бы на `null`). Авто-открытие
                      (`openDueContests`) читает `startsAt` только у
                      конкурсов в статусе `draft` — после открытия (вручную
                      или само) значение больше ни на что не влияет, и
                      предлагать его к правке — приглашение на путаницу. */
                %>
                <input class="form-control" id="contest-edit-startsAt" type="datetime-local"
                       name="startsAt" value="<%= contestEditDraft.startsAt %>"
                       <%= contest.status === 'draft' ? '' : 'readonly' %> />
                <small class="form-hint">
                  <% if (contest.status === 'draft') { %>
                    Пусто — открыть только вручную.
                  <% } else { %>
                    Приём уже идёт — дальше ни на что не влияет.
                  <% } %>
                </small>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="contest-edit-endsAt">Завершение</label>
                <input class="form-control" id="contest-edit-endsAt" type="datetime-local"
                       name="endsAt" value="<%= contestEditDraft.endsAt %>" />
                <small class="form-hint">
                  Пусто — разыграть только вручную. Не в прошлом и требует
                  хотя бы одного призового места.
                </small>
              </div>
            </div>
            <%- include('required-groups', { maxGroups: maxGroups, selected: contestEditDraft.requiredGroupIds, inactiveGroups: inactiveRequired }) %>
            <div class="mb-3">
              <label class="form-check">
                <input class="form-check-input" type="checkbox" name="notifyWinners"
                       <%= contestEditDraft.notifyWinners ? 'checked' : '' %> />
                <span class="form-check-label">Уведомлять победителей в личку</span>
              </label>
            </div>
            <div class="mb-1">
              <label class="form-check">
                <input class="form-check-input" type="checkbox" name="publishResultsInPost"
                       <%= contestEditDraft.publishResultsInPost ? 'checked' : '' %> />
                <span class="form-check-label">Дописать победителей в текст конкурса</span>
              </label>
            </div>
          </div>
          <div class="card-footer">
            <button class="btn btn-primary" type="submit">Сохранить</button>
          </div>
        </form>
      </div>
    <% } %>
  </div>
</div>
