<h1 class="page-title mb-3">Админы</h1>

<% if (issued) { %>
  <%
     /* Пароль показывается ровно один раз — в базе только его хеш, повторно
        его не узнать. Страница отдаётся с `Cache-Control: no-store`. */
  %>
  <div class="alert alert-success" role="alert">
    <div class="mb-2">
      <% if (issued.reason === 'created') { %>
        Добавлен <strong><%= issued.admin.email %></strong>. Пароль для входа:
      <% } else { %>
        Новый пароль для <strong><%= issued.admin.email %></strong> (прежние входы завершены):
      <% } %>
    </div>
    <code class="fs-3 user-select-all"><%= issued.password %></code>
    <div class="small mt-2">
      Сохраните и передайте его сейчас — второй раз он не показывается.
    </div>
  </div>
<% } %>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="table-responsive">
        <table class="table card-table table-vcenter">
          <thead>
            <tr>
              <th>Email</th>
              <th>Роль и MAX id</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% admins.forEach(function (a) { %>
              <tr class="<%= a.disabledAt ? 'text-secondary' : '' %>">
                <td>
                  <%= a.email %>
                  <% if (a.id === selfId) { %><span class="tag tag-blue ms-1">это вы</span><% } %>
                  <% if (a.disabledAt) { %>
                    <div><span class="tag tag-red">отключён <%= formatDate(a.disabledAt) %></span></div>
                  <% } %>
                  <div class="small text-secondary">добавлен <%= formatDate(a.createdAt) %></div>
                </td>
                <td>
                  <form method="post" action="/panel/admins/<%= a.id %>/edit" class="d-flex flex-wrap gap-2 align-items-center m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <select class="form-select form-select-sm w-auto" name="role" aria-label="Роль">
                      <option value="admin" <%= a.role === 'admin' ? 'selected' : '' %>>admin</option>
                      <option value="developer" <%= a.role === 'developer' ? 'selected' : '' %>>developer</option>
                    </select>
                    <input class="form-control form-control-sm" style="width: 9rem" name="maxUserId"
                           value="<%= a.maxUserId || '' %>" placeholder="MAX user id"
                           inputmode="numeric" autocomplete="off" aria-label="MAX user id" />
                    <button class="btn btn-sm" type="submit">Сохранить</button>
                  </form>
                </td>
                <td class="text-end text-nowrap">
                  <form method="post" action="/panel/admins/<%= a.id %>/reset-password" class="d-inline m-0"
                        onsubmit="return confirm('Выдать новый пароль? Старый перестанет работать, все входы этого админа завершатся.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-sm" type="submit">Новый пароль</button>
                  </form>
                  <% if (a.id !== selfId) { %>
                    <% if (a.disabledAt) { %>
                      <form method="post" action="/panel/admins/<%= a.id %>/enable" class="d-inline m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="btn btn-sm" type="submit">Включить</button>
                      </form>
                    <% } else { %>
                      <%
                         /* Email — в data-атрибут, не в текст обработчика:
                            браузер раскодирует `&#39;` до запуска JS, и
                            кавычка в email (валидатор её пропускает)
                            разорвала бы строку — хранимый XSS. */
                      %>
                      <form method="post" action="/panel/admins/<%= a.id %>/disable" class="d-inline m-0"
                            data-email="<%= a.email %>"
                            onsubmit="return confirm('Отключить ' + this.dataset.email + '? Войти он больше не сможет, текущие входы завершатся сразу.')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Отключить</button>
                      </form>
                    <% } %>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-secondary small mt-2">
      <strong>admin</strong> ведёт посты и конкурсы. <strong>developer</strong>
      может всё, включая группы и эту страницу. Удалить админа нельзя, только
      отключить: его действия остаются в журналах. Себя отключить или понизить
      нельзя, как и последнего активного developer.
    </p>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Добавить админа</h3></div>
      <form method="post" action="/panel/admins">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="card-body">
          <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>
          <div class="mb-3">
            <label class="form-label" for="admin-email">Email</label>
            <input class="form-control" id="admin-email" type="email" name="email" required
                   autocomplete="off" value="<%= draft.email %>" />
          </div>
          <div class="mb-3">
            <label class="form-label" for="admin-role">Роль</label>
            <select class="form-select" id="admin-role" name="role">
              <option value="admin" <%= draft.role === 'admin' ? 'selected' : '' %>>admin — посты и конкурсы</option>
              <option value="developer" <%= draft.role === 'developer' ? 'selected' : '' %>>developer — всё</option>
            </select>
          </div>
          <div class="mb-1">
            <label class="form-label" for="admin-max">MAX user id <span class="text-secondary">(необязательно)</span></label>
            <input class="form-control" id="admin-max" name="maxUserId" inputmode="numeric"
                   autocomplete="off" value="<%= draft.maxUserId %>" />
            <small class="form-hint">
              Бот присылает его в ответ на <code>/start</code>. С ним админ
              получает уведомления бота (новые группы, подключения) и может
              подтверждать группы прямо из чата.
            </small>
          </div>
        </div>
        <div class="card-footer">
          <button class="btn btn-primary" type="submit">Добавить</button>
          <div class="form-hint mt-2">Пароль сгенерируется и покажется один раз.</div>
        </div>
      </form>
    </div>
  </div>
</div>
