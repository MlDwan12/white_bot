<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <div class="text-secondary small">Пост от <%= formatDate(post.createdAt) %></div>
    <h1 class="page-title m-0">
      <span class="tag tag-<%= statusColor(post.status) %> me-2"><%= statusLabel(post.status) %></span>
    </h1>
  </div>
  <a class="btn" href="/panel/campaigns">К списку</a>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Текст</h3></div>
      <div class="card-body">
        <div style="white-space: pre-wrap"><%= post.text %></div>
        <% if (post.attachments.length > 0) { %>
          <div class="mt-3">
            <div class="text-secondary small mb-1">Вложения:</div>
            <div class="d-flex flex-wrap gap-3">
              <% post.attachments.forEach(function (a) { %>
                <div class="d-flex align-items-center text-secondary small">
                  <%- include('media-thumb', { m: a.mediaAsset }) %>
                  <%= a.mediaAsset.filename %>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">Доставки</h3></div>
      <div class="table-responsive">
        <table class="table card-table table-vcenter">
          <thead>
            <tr>
              <th>Группа</th>
              <th>Статус</th>
              <th>Опубликовано</th>
            </tr>
          </thead>
          <tbody>
            <% post.deliveries.forEach(function (d) { %>
              <tr>
                <td>
                  <%= d.group.title %>
                  <span class="tag tag-<%= platformColor(d.group.platform) %> ms-1"><%= platformLabel(d.group.platform) %></span>
                </td>
                <td>
                  <span class="tag tag-<%= deliveryColor(d) %>"><%= deliveryLabel(d) %></span>
                  <% if (d.error) { %>
                    <div class="tone-red small mt-1"><%= d.error %></div>
                  <% } %>
                </td>
                <td class="text-secondary small">
                  <%= d.sentAt ? formatDate(d.sentAt) : '—' %>
                  <% if (d.autoDeleteDueAt && !d.deletedAt) { %>
                    <div>удалится <%= formatDate(d.autoDeleteDueAt) %></div>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <%
       /* Вне карточки и вне ветки `publishedGroups.length > 0`: отказ
          правки/загрузки перерисовывает эту же страницу, и если к тому
          моменту список доставок вдруг опустел (например, пост успели
          удалить из всех групп в другой вкладке), баннер внутри скрытой
          формы никто бы не увидел — а набранное уже потеряно. */
    %>
    <% if (editError) { %>
      <div class="alert alert-danger mb-3" role="alert"><%= editError %></div>
    <% } %>
    <% if (publishedGroups.length > 0) { %>
      <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Правка опубликованного</h3></div>
        <form method="post" action="/panel/campaigns/<%= post.id %>/edit-published">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="card-body">
            <%
               /* Подтверждения на проталкивание нет намеренно: это и есть
                  смысл действия — текст меняется везде, где пост уже вышел.
                  Если рассылка ещё идёт, сервер сначала остановит её. */
            %>
            <div class="mb-3">
              <label class="form-label" for="edit-text">Новый текст</label>
              <textarea class="form-control" id="edit-text" name="text" rows="5" required><%= editDraft.text %></textarea>
            </div>
            <%
               /* Переопределения показываются всегда, а не только когда
                  заданы: иначе правка отрапортовала бы об успехе, пока VK
                  показывает старый текст, которого в панели даже не видно.
                  Пустое поле означает «нет переопределения». */
            %>
            <div class="mb-3">
              <label class="form-label" for="vk-text">Текст для VK</label>
              <textarea class="form-control" id="vk-text" name="vkTextOverride" rows="2"
                        placeholder="пусто — общий текст"><%= editDraft.vkTextOverride %></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label" for="max-text">Текст для MAX</label>
              <textarea class="form-control" id="max-text" name="maxTextOverride" rows="2"
                        placeholder="пусто — общий текст"><%= editDraft.maxTextOverride %></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label" for="autoDeleteAfterMinutes">Удалить через (минут)</label>
              <input class="form-control" id="autoDeleteAfterMinutes" type="number" min="1"
                     name="autoDeleteAfterMinutes"
                     value="<%= editDraft.autoDeleteAfterMinutes %>" />
              <small class="form-hint">
                Пусто — не удалять автоматически.
                <% if (post.autoDeleteAt) { %>
                  Сейчас назначено на <%= formatDate(post.autoDeleteAt) %>;
                  сохранение формы отменит это.
                <% } %>
              </small>
            </div>

            <%
               /* Снятые галочки — не «поле не прислали», а осознанное «убрать
                  картинку»: форма правки несёт полный список вложений всегда,
                  и сервис заменяет их им целиком (см. `editPublished`). */
            %>
            <% if (media.length > 0) { %>
              <div class="mb-3">
                <label class="form-label">Вложения</label>
                <% media.forEach(function (m) { %>
                  <label class="form-check d-flex align-items-center">
                    <input class="form-check-input" type="checkbox" name="attachmentIds"
                           value="<%= m.id %>"
                           <%= editDraft.attachmentIds.includes(m.id) ? 'checked' : '' %> />
                    <span class="form-check-label d-flex align-items-center">
                      <%- include('media-thumb', { m: m }) %>
                      <%= m.filename %> <span class="text-secondary small ms-1"><%= mediaKindLabel(m.kind) %></span>
                    </span>
                  </label>
                <% }); %>
              </div>
            <% } %>
            <div class="mb-1">
              <label class="form-label" for="edit-file">Загрузить новый файл</label>
              <input class="form-control" id="edit-file" type="file" name="file" />
              <small class="form-hint">
                До 50 МБ. Загрузится и отметится сам, набранное в форме
                сохранится. К посту файл прикрепляется только кнопкой
                «Загрузить» — «Сохранить» его не берёт.
              </small>
            </div>
          </div>
          <div class="card-footer d-flex gap-2">
            <button class="btn btn-primary" type="submit">Сохранить и обновить везде</button>
            <%
               /* `formnovalidate`: у текста стоит `required`, и без этого
                  загрузить файл до правки текста было бы нельзя. Кнопка
                  стоит второй в документе — Enter в текстовом поле должен
                  сохранять правку, а не запускать загрузку. */
            %>
            <button class="btn" type="submit" formaction="/panel/campaigns/<%= post.id %>/media"
                    formenctype="multipart/form-data" formnovalidate>Загрузить</button>
          </div>
        </form>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title">Удалить опубликованное</h3></div>
        <form method="post" action="/panel/campaigns/<%= post.id %>/delete-published">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="card-body">
            <%
               /* Галочки, а не одна кнопка «удалить везде»: пожаловаться
                  может одна площадка, и сносить пост в остальных из-за
                  этого незачем. По умолчанию отмечены все. */
            %>
            <% publishedGroups.forEach(function (g) { %>
              <label class="form-check">
                <input class="form-check-input" type="checkbox" name="groupIds" value="<%= g.id %>" checked />
                <span class="form-check-label"><%= g.title %></span>
              </label>
            <% }); %>
          </div>
          <div class="card-footer">
            <button class="btn btn-danger w-100" type="submit">Удалить из отмеченных</button>
          </div>
        </form>
      </div>
    <% } else { %>
      <div class="card">
        <div class="card-body text-secondary">
          Пост ещё нигде не опубликован — править и удалять нечего.
        </div>
      </div>
    <% } %>

    <div class="card mt-3">
      <div class="card-header"><h3 class="card-title">Разослать в личку</h3></div>
      <div class="card-body">
        <%
           /* Текст поста — тот же, что выше, специальной формы под него
              нет: рассылка отправляет существующий пост, не новое
              сообщение. Только MAX — VK пока не умеет личку от сообщества. */
        %>
        <form method="get" action="/panel/campaigns/<%= post.id %>" class="input-group mb-3">
          <input class="form-control" type="text" name="dmQuery"
                 placeholder="Найти по имени или username"
                 value="<%= dmQuery || '' %>" />
          <button class="btn" type="submit">Найти</button>
        </form>

        <form method="post" action="/panel/campaigns/<%= post.id %>/direct-messages">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <%
             /* Ничего не отмечено по умолчанию — ни здесь, ни в других
                режимах ниже: поиск, сделанный «просто посмотреть», не должен
                молча стать выбранным получателем, если админ передумает и
                отправит форму в другом режиме. Явный клик — единственный
                способ что-то выбрать. */
          %>
          <div class="mb-3">
            <label class="form-check">
              <input class="form-check-input" type="radio" name="mode" value="user" />
              <span class="form-check-label">Конкретному человеку</span>
            </label>
            <div class="ms-4 mt-1">
              <% if (dmResults && dmResults.length > 0) { %>
                <% dmResults.forEach(function (u) { %>
                  <label class="form-check d-flex align-items-center">
                    <input class="form-check-input" type="radio" name="platformUserId"
                           value="<%= u.id %>" />
                    <span class="form-check-label">
                      <%= u.displayName %>
                      <% if (u.username) { %><span class="text-secondary">@<%= u.username %></span><% } %>
                    </span>
                  </label>
                <% }); %>
              <% } else if (dmQuery) { %>
                <div class="text-secondary small">Никого не нашлось по «<%= dmQuery %>»</div>
              <% } %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-check">
              <input class="form-check-input" type="radio" name="mode" value="group" />
              <span class="form-check-label">Участникам группы</span>
            </label>
            <div class="ms-4 mt-1">
              <% if (dmGroups.length > 0) { %>
                <%
                   /* Без `selected` браузер по умолчанию выбрал бы первую
                      группу из списка — незаметно для админа, который не
                      трогал список вовсе. Пустой плейсхолдер первым пунктом
                      делает это явным пустым значением: `dmSelectorFrom`
                      уже отбрасывает пустой `groupId` как «ничего не
                      выбрано», а не как первую группу в списке. */
                %>
                <select class="form-select" name="groupId">
                  <option value="">— выберите группу —</option>
                  <% dmGroups.forEach(function (g) { %>
                    <option value="<%= g.id %>"><%= g.title %></option>
                  <% }); %>
                </select>
              <% } else { %>
                <span class="text-secondary small">Нет активных MAX-групп</span>
              <% } %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-check">
              <input class="form-check-input" type="radio" name="mode" value="all" />
              <span class="form-check-label">Всем в базе</span>
            </label>
          </div>

          <button class="btn btn-primary" type="submit">Разослать</button>
        </form>
      </div>
    </div>
  </div>
</div>
