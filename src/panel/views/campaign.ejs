<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <div class="text-secondary small">Кампания от <%= formatDate(post.createdAt) %></div>
    <h1 class="page-title m-0">
      <span class="badge bg-<%= statusColor(post.status) %> me-2"><%= statusLabel(post.status) %></span>
    </h1>
  </div>
  <a class="btn" href="/panel/campaigns">К списку</a>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Текст</h3></div>
      <div class="card-body">
        <div style="white-space: pre-wrap"><%= post.text %></div>
        <% if (post.attachments.length > 0) { %>
          <div class="mt-3 text-secondary small">
            Вложения:
            <%= post.attachments.map(function (a) { return a.mediaAsset.filename; }).join(', ') %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">Доставки</h3></div>
      <div class="table-responsive">
        <table class="table card-table table-vcenter">
          <thead>
            <tr>
              <th>Группа</th>
              <th>Статус</th>
              <th>Опубликовано</th>
            </tr>
          </thead>
          <tbody>
            <% post.deliveries.forEach(function (d) { %>
              <tr>
                <td>
                  <%= d.group.title %>
                  <span class="badge bg-secondary ms-1"><%= d.group.platform %></span>
                </td>
                <td>
                  <span class="badge bg-<%= deliveryColor(d) %>"><%= deliveryLabel(d) %></span>
                  <% if (d.error) { %>
                    <div class="text-red small mt-1"><%= d.error %></div>
                  <% } %>
                </td>
                <td class="text-secondary small">
                  <%= d.sentAt ? formatDate(d.sentAt) : '—' %>
                  <% if (d.autoDeleteDueAt && !d.deletedAt) { %>
                    <div>удалится <%= formatDate(d.autoDeleteDueAt) %></div>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <% if (publishedGroups.length > 0) { %>
      <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Правка опубликованного</h3></div>
        <form method="post" action="/panel/campaigns/<%= post.id %>/edit-published">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="card-body">
            <%
               /* Подтверждения на проталкивание нет намеренно: это и есть
                  смысл действия — текст меняется везде, где пост уже вышел.
                  Если рассылка ещё идёт, сервер сначала остановит её. */
            %>
            <div class="mb-3">
              <label class="form-label" for="edit-text">Новый текст</label>
              <textarea class="form-control" id="edit-text" name="text" rows="5" required><%= post.text %></textarea>
            </div>
            <%
               /* Переопределения показываются всегда, а не только когда
                  заданы: иначе правка отрапортовала бы об успехе, пока VK
                  показывает старый текст, которого в панели даже не видно.
                  Пустое поле означает «нет переопределения». */
            %>
            <div class="mb-3">
              <label class="form-label" for="vk-text">Текст для VK</label>
              <textarea class="form-control" id="vk-text" name="vkTextOverride" rows="2"
                        placeholder="пусто — общий текст"><%= post.vkTextOverride || '' %></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label" for="max-text">Текст для MAX</label>
              <textarea class="form-control" id="max-text" name="maxTextOverride" rows="2"
                        placeholder="пусто — общий текст"><%= post.maxTextOverride || '' %></textarea>
            </div>

            <div class="mb-2">
              <label class="form-label" for="autoDeleteAfterMinutes">Удалить через (минут)</label>
              <input class="form-control" id="autoDeleteAfterMinutes" type="number" min="1"
                     name="autoDeleteAfterMinutes"
                     value="<%= post.autoDeleteAfterMinutes || '' %>" />
              <small class="form-hint">
                Пусто — не удалять автоматически.
                <% if (post.autoDeleteAt) { %>
                  Сейчас назначено на <%= formatDate(post.autoDeleteAt) %>;
                  сохранение формы отменит это.
                <% } %>
              </small>
            </div>
          </div>
          <div class="card-footer">
            <button class="btn btn-primary w-100" type="submit">Сохранить и обновить везде</button>
          </div>
        </form>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title">Удалить опубликованное</h3></div>
        <form method="post" action="/panel/campaigns/<%= post.id %>/delete-published">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="card-body">
            <%
               /* Галочки, а не одна кнопка «удалить везде»: пожаловаться
                  может одна площадка, и сносить пост в остальных из-за
                  этого незачем. По умолчанию отмечены все. */
            %>
            <% publishedGroups.forEach(function (g) { %>
              <label class="form-check">
                <input class="form-check-input" type="checkbox" name="groupIds" value="<%= g.id %>" checked />
                <span class="form-check-label"><%= g.title %></span>
              </label>
            <% }); %>
          </div>
          <div class="card-footer">
            <button class="btn btn-danger w-100" type="submit">Удалить из отмеченных</button>
          </div>
        </form>
      </div>
    <% } else { %>
      <div class="card">
        <div class="card-body text-secondary">
          Пост ещё нигде не опубликован — править и удалять нечего.
        </div>
      </div>
    <% } %>
  </div>
</div>
