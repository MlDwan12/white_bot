<h1 class="page-title mb-3">Новый пост</h1>

<%
   /* Вся страница — одна форма, включая загрузку файла.

      Раньше загрузка была отдельной формой, и после неё страница
      перерисовывалась пустой: набранный текст, выбранные группы и срок
      пропадали. Теперь кнопка «Загрузить» отправляет **всю** форму вместе с
      файлом на другой адрес (`formaction`), а сервер возвращает страницу с
      набранным и сам отмечает новое вложение. Работает без JavaScript.

      Порядок в документе важен: неявную отправку по Enter в поле формы
      выполняет первая кнопка отправки, и это должна оставаться «Отправить»,
      а не «Загрузить» — поэтому блок загрузки стоит правее и ниже. */
%>
<form method="post" action="/panel/posts">
<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <div class="mb-3">
          <label class="form-label" for="text">Текст</label>
          <textarea class="form-control" id="text" name="text" rows="6" required><%= draft.text %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Куда отправить</label>
          <% if (groups.length === 0) { %>
            <div class="text-secondary">Нет активных групп.</div>
          <% } else { %>
            <% groups.forEach(function (g) { %>
              <label class="form-check">
                <input class="form-check-input" type="checkbox" name="groupIds"
                       value="<%= g.id %>"
                       <%= draft.groupIds.includes(g.id) ? 'checked' : '' %> />
                <span class="form-check-label">
                  <%= g.title %>
                  <span class="tag tag-<%= platformColor(g.platform) %> ms-1"><%= platformLabel(g.platform) %></span>
                </span>
              </label>
            <% }); %>
          <% } %>
        </div>

        <div class="mb-3">
          <label class="form-label" for="scheduledAt">Когда</label>
          <input class="form-control" id="scheduledAt" type="datetime-local"
                 name="scheduledAt" value="<%= draft.scheduledAt %>" />
          <small class="form-hint">Пусто — отправить сразу.</small>
        </div>

        <% if (media.length > 0) { %>
          <div class="mb-3">
            <label class="form-label">Вложения</label>
            <% media.forEach(function (m) { %>
              <label class="form-check d-flex align-items-center">
                <input class="form-check-input" type="checkbox" name="attachmentIds"
                       value="<%= m.id %>"
                       <%= draft.attachmentIds.includes(m.id) ? 'checked' : '' %> />
                <span class="form-check-label d-flex align-items-center">
                  <%- include('media-thumb', { m: m }) %>
                  <%= m.filename %> <span class="text-secondary small ms-1"><%= mediaKindLabel(m.kind) %></span>
                </span>
              </label>
            <% }); %>
          </div>
        <% } %>
      </div>
      <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary" type="submit" name="action" value="send">Отправить</button>
        <button class="btn" type="submit" name="action" value="draft">Сохранить черновик</button>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <label class="form-label" for="file">Загрузить вложение</label>
        <input class="form-control" id="file" type="file" name="file" />
        <small class="form-hint">
          Файл до 50 МБ. После загрузки он появится в списке слева и
          отметится сам, а всё набранное сохранится. Выбранный файл к посту
          прикрепляется только кнопкой «Загрузить» — «Отправить» его не
          берёт.
        </small>
      </div>
      <div class="card-footer">
        <%
           /* `formnovalidate`: у текста стоит `required`, и без этого
              загрузить файл до того, как текст набран, было бы нельзя.
              `formenctype`: сама форма — обычная, а файлу нужен multipart. */
        %>
        <button class="btn w-100" type="submit" formaction="/panel/media"
                formenctype="multipart/form-data" formnovalidate>Загрузить</button>
      </div>
    </div>
  </div>
</div>
</form>
