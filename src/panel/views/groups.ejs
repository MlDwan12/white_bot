<h1 class="page-title mb-3">Группы</h1>

<%
   /* Личный токен VK нужен только для вложений (картинки, файлы) в постах
      VK: токен сообщества загружать их не умеет. Живёт сутки, и продлить его
      можно лишь заново пройдя авторизацию — VK не выдаёт токен обновления.
      Поэтому статус виден на этой странице, а не выясняется в момент, когда
      отправка уже отказала. */
%>
<div class="card mb-3" id="vk-token">
  <div class="card-header">
    <h3 class="card-title">Личный токен VK — для вложений в постах VK</h3>
    <div class="ms-auto">
      <% if (vkToken.state === 'usable') { %>
        <span class="tag tag-green">действует до <%= formatDate(vkToken.expiresAt) %></span>
      <% } else if (vkToken.state === 'expired') { %>
        <span class="tag tag-red">истёк <%= formatDate(vkToken.expiresAt) %></span>
      <% } else { %>
        <span class="tag tag-red">не подключён</span>
      <% } %>
    </div>
  </div>
  <div class="card-body">
    <p class="text-secondary">
      Нужен, только если в пост VK прикрепляются картинки или файлы: без него
      такой пост не отправится. Текстовым постам и постам в MAX он не нужен.
      Токен живёт сутки, продлевается вручную — в два шага ниже.
    </p>
    <% if (!vkAppConfigured) { %>
      <div class="alert alert-warning mb-0" role="alert">
        Не заданы <code>VK_APP_ID</code> и <code>VK_APP_CLIENT_SECRET</code> в
        настройках сервера — подключить токен нельзя.
      </div>
    <% } else if (can('groups_tokens_manage')) { %>
      <ol class="mb-3 ps-3">
        <li class="mb-2">
          Нажмите кнопку — откроется VK. Войдите под тем аккаунтом, от имени
          которого будут загружаться вложения, и разрешите доступ.
          <div class="mt-2">
            <a class="btn btn-primary" href="/vk/oauth/authorize" target="_blank" rel="noopener">1. Открыть авторизацию VK</a>
          </div>
        </li>
        <li>
          После разрешения VK покажет пустую страницу. Скопируйте её адрес из
          адресной строки браузера целиком и вставьте ниже.
        </li>
      </ol>
      <form method="post" action="/panel/vk-token" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label class="form-label" for="pasted">Адрес страницы после разрешения доступа</label>
        <div class="d-flex gap-2">
          <input class="form-control" id="pasted" name="pasted" required autocomplete="off"
                 placeholder="https://oauth.vk.com/blank.html?code=…" />
          <button class="btn btn-primary text-nowrap" type="submit">2. Подключить</button>
        </div>
        <small class="form-hint">
          Между шагами не должно пройти больше 10 минут, и оба шага делаются в
          одном браузере.
        </small>
      </form>
    <% } else { %>
      <div class="text-secondary">Подключить токен может только разработчик.</div>
    <% } %>
  </div>
</div>

<% if (pending.length > 0 && can('groups_pendingMax_review')) { %>
  <div class="card mb-3 border-warning">
    <div class="card-header">
      <h3 class="card-title">Ждут подтверждения</h3>
    </div>
    <div class="card-body">
      <p class="text-secondary">
        Бот добавлен в эти чаты и каналы MAX, но рассылать туда нельзя,
        пока вы не подтвердите.
      </p>
      <% pending.forEach(function (g) { %>
        <div class="d-flex align-items-center gap-2 mb-2">
          <div class="flex-fill">
            <strong><%= g.title %></strong>
            <span class="tag tag-secondary ms-1"><%= groupKindLabel(g.kind) %></span>
          </div>
          <form method="post" action="/panel/groups/<%= g.id %>/confirm" class="m-0 d-flex gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input class="form-control form-control-sm" style="width: 14rem"
                   name="tags" placeholder="теги через запятую" />
            <button class="btn btn-sm btn-primary" type="submit">Подтвердить</button>
          </form>
          <form method="post" action="/panel/groups/<%= g.id %>/reject" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn btn-sm" type="submit">Отклонить</button>
          </form>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<div class="row g-3">
  <div class="col-lg-<%= can('groups_manage') ? '8' : '12' %>">
    <div class="card">
      <div class="table-responsive">
        <table class="table card-table table-vcenter">
          <thead>
            <tr>
              <th>Группа</th>
              <th>Статус</th>
              <th>Теги</th>
              <th class="w-1"></th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(function (g) { %>
              <tr>
                <td>
                  <strong><%= g.title %></strong>
                  <span class="tag tag-<%= platformColor(g.platform) %> ms-1"><%= platformLabel(g.platform) %></span>
                  <div class="text-secondary small">
                    id <%= g.externalId %>
                    <% if (g.tokenMask) { %>
                      <%
                         /* Маска, а не токен: показывать секрет на странице,
                            которую видит любой вошедший, незачем — узнать
                            его заново всё равно неоткуда, а утечь он может. */
                      %>
                      · токен <%= g.tokenMask %>
                    <% } %>
                  </div>
                </td>
                <td>
                  <span class="tag tag-<%= groupColor(g.status) %>"><%= groupLabel(g.status) %></span>
                </td>
                <td>
                  <% if (can('groups_tags_edit')) { %>
                    <form method="post" action="/panel/groups/<%= g.id %>/tags" class="m-0 d-flex gap-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input class="form-control form-control-sm" name="tags"
                             value="<%= g.tags.join(', ') %>" placeholder="через запятую" />
                      <%
                         /* Теги ходят одной строкой через запятую, поэтому
                            тег с запятой внутри (такой может прийти только
                            через API) при сохранении отсюда разделится на
                            два. Панель сама такие не создаёт. */
                      %>
                      <button class="btn btn-sm" type="submit">Сохранить</button>
                    </form>
                  <% } else { %>
                    <%= g.tags.join(', ') || '—' %>
                  <% } %>
                </td>
                <td>
                  <%
                     /* Не только для активных: группа с неработающим
                        токеном или с удалённым ботом тоже должна убираться
                        из списка, иначе она висит там навсегда. */
                  %>
                  <% if (can('groups_manage') && g.status !== 'removed') { %>
                    <form method="post" action="/panel/groups/<%= g.id %>/deactivate" class="m-0">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button class="btn btn-sm" type="submit">Отключить</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (can('groups_manage')) { %>
    <div class="col-lg-4">
      <form method="post" action="/panel/groups/vk" class="card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="card-header"><h3 class="card-title">Добавить VK-сообщество</h3></div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="token">Токен сообщества</label>
            <input class="form-control" id="token" type="password" name="token" required
                   autocomplete="off" />
            <small class="form-hint">
              Название и id подтянутся из VK по токену — вводить их не нужно.
            </small>
          </div>
          <div class="mb-2">
            <label class="form-label" for="tags">Теги</label>
            <input class="form-control" id="tags" name="tags" placeholder="через запятую" />
          </div>
        </div>
        <div class="card-footer">
          <button class="btn btn-primary w-100" type="submit">Добавить</button>
        </div>
      </form>

      <div class="card mt-3">
        <div class="card-body text-secondary small">
          MAX-группы добавляются сами: пригласите бота в чат или канал, и он
          появится в списке ожидающих подтверждения.
        </div>
      </div>
    </div>
  <% } %>
</div>
